              }
            }
          }
        },
        {
          "name": "5. Запланировать сеанс",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Успешный ответ', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('sessionId', pm.response.json().id);"
