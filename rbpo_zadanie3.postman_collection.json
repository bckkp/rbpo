  "item": [
    {
      "name": "Основной сценарий",
      "description": "Создаёт исходные данные и выполняет пять бизнес-операций. Запросы рассчитаны на последовательный запуск.",
      "item": [
        {
          "name": "1. Создать наблюдателя",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Успешный ответ', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"observer_{{runId}}\",\n  \"fullName\": \"Учебный наблюдатель\",\n  \"email\": \"observer_{{runId}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Создать небесный объект",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Успешный ответ', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('objectId', pm.response.json().id);"
                ]
              }
