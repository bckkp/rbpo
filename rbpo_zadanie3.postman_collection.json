            "url": "{{baseUrl}}/api/observation-sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"celestialObjectId\": {{objectId}},\n  \"telescopeId\": {{telescopeId}},\n  \"observerId\": {{userId}},\n  \"startTime\": \"2027-01-10T18:00:00Z\",\n  \"endTime\": \"2027-01-10T19:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Перенести сеанс",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Интервал изменён', () => pm.expect(pm.response.json().startTime).to.eql('2027-01-10T19:00:00Z'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/observation-sessions/{{sessionId}}/reschedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"2027-01-10T19:00:00Z\",\n  \"endTime\": \"2027-01-10T20:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Сменить телескоп",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Телескоп изменён', () => pm.expect(pm.response.json().telescopeId).to.eql(Number(pm.collectionVariables.get('telescope2Id'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/observation-sessions/{{sessionId}}/change-telescope",
