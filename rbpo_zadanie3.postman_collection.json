          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/celestial-objects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Учебный Марс {{runId}}\",\n  \"type\": \"PLANET\",\n  \"minAperture\": 70\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
