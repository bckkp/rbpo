            ],
            "url": "{{baseUrl}}/api/observation-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": {{sessionId}},\n  \"description\": \"Видны детали поверхности\",\n  \"quality\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Завершить сеанс",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Сеанс завершён', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/observation-sessions/{{sessionId}}/complete"
          }
        },
        {
          "name": "12. Создать сеанс для отмены",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Успешный ответ', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('cancelledSessionId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/observation-sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"celestialObjectId\": {{objectId}},\n  \"telescopeId\": {{telescopeId}},\n  \"observerId\": {{userId}},\n  \"startTime\": \"2027-01-10T21:00:00Z\",\n  \"endTime\": \"2027-01-10T22:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "13. Отменить запланированный сеанс",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Сеанс отменён', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/observation-sessions/{{cancelledSessionId}}/cancel"
          }
        },
        {
          "name": "14. Проверить освобождение телескопа",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Телескоп доступен', () => pm.expect(pm.response.json().available).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/telescopes/{{telescope2Id}}"
          }
        }
